---
import "@styles/global.css"
import { Icon } from "astro-icon/components"
import { i18n } from "astro:config/client";
import i18nit from "@i18n/translation"
import { getColumnsMeta } from "@utils/column-utils"
import { getRelativeLocaleUrl } from "@utils/url-utils"
import type { ColumnMeta } from "@/types/column"

const currentLang = Astro.currentLocale || i18n!.defaultLocale;
const t = i18nit(currentLang);

const columns: ColumnMeta[] = await getColumnsMeta(currentLang);

// Pre-compute article count texts
const articleCountMap = new Map<string, string>();
for (const col of columns) {
    articleCountMap.set(col.slug, t("column.articleCount", { count: col.articleCount }));
}
---

{columns.length > 0 && (
    <div
        data-aos="fade-left"
        data-aos-delay="200"
        class="column-panel w-full max-w-[280px] mx-auto mt-4 p-4 rounded-xl shadow border border-[var(--button-border-color)] bg-[var(--surface-color)] text-[var(--text-color)] transition-all duration-300 hover:shadow-lg hover:border-[var(--link-color)]"
    >
        <h3 class="text-sm font-semibold text-[var(--text-color-70)] uppercase tracking-wider mb-3 flex items-center gap-2">
            <Icon name="fa6-solid:table-columns" class="w-4 h-4" />
            {t("column.title")}
        </h3>
        <ul class="space-y-2">
            {columns.map((col) => (
                <li>
                    <a
                        href={getRelativeLocaleUrl(currentLang, `/column/${col.slug}`)}
                        class="column-item flex items-start gap-2.5 px-2.5 py-2 rounded-lg text-sm text-[var(--text-color)] hover:bg-[var(--button-hover-color)] transition-all duration-200 group"
                    >
                        <Icon
                            name={col.icon}
                            class="w-4 h-4 mt-0.5 shrink-0 text-[var(--text-color-70)] group-hover:text-[var(--link-color)] transition-colors"
                        />
                        <div class="min-w-0 flex-1">
                            <span class="block font-medium truncate group-hover:text-[var(--link-color)] transition-colors">
                                {col.title}
                            </span>
                            {col.description && (
                                <span class="block text-xs text-[var(--text-color-70)] mt-0.5 line-clamp-2">
                                    {col.description}
                                </span>
                            )}
                            <span class="block text-xs text-[var(--text-color-70)] opacity-70 mt-1">
                                {articleCountMap.get(col.slug)}
                            </span>
                        </div>
                    </a>
                </li>
            ))}
        </ul>
    </div>
)}

<style>
    .column-item:hover svg:first-child {
        transform: scale(1.15);
    }
    .column-item svg:first-child {
        transition: transform 0.2s ease;
    }
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>
