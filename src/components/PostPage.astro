---
import { blogCoverUrl, contentCoverUrl } from '@utils/url-utils'
import PostCard from '@components/PostCard.astro';
import type { CollectionEntry } from 'astro:content';

const { page, urlPrefix = "/blog/" } = Astro.props;

---
<div id="post-list-top" class="scroll-mt-24">
{page.data.map((entry: CollectionEntry<"blog"> | CollectionEntry<"bookReview">) => (
        <PostCard
            entry={entry}
            title={entry.data.title}
            description={entry.data.description}
            image={entry.collection === 'bookReview'
                ? contentCoverUrl(entry.data.cover || entry.data.image, entry.id, 'book-review')
                : blogCoverUrl(entry.data.cover || entry.data.image, entry.id)}
            pubDate={entry.data.pubDate}
            url={entry.id}
            fallback={entry.isFallback ?? false}
            urlPrefix={urlPrefix}>
        </PostCard>
))}
</div>