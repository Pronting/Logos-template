---
import { i18n } from "astro:config/client";
import { Icon } from "astro-icon/components";
import i18nit from '@i18n/translation'

interface Props {
    prev: any;
    next: any;
}

const { prev, next } = Astro.props;

const currentLang = Astro.currentLocale || i18n!.defaultLocale;
const t = i18nit(currentLang);

// 辅助函数：根据文章 id 和当前语言生成正确的 URL
function getPostUrl(id: string) {
  const isDefault = currentLang === i18n?.defaultLocale;
  return isDefault ? `/blog/${id}` : `/${currentLang}/blog/${id}`;
}
---

<nav data-aos="fade-up" class="blog-navi">
    <div class="blog-navi-grid">
        <div class="flex-1 min-w-0">
            {prev && (
            <a 
                href={getPostUrl(prev.id)} 
                class="blog-navi-link group"
            >
                <div class="blog-navi-label">
                    <Icon name="fa6-solid:arrow-left" class="h-4 w-4 transition-transform duration-300 group-hover:-translate-x-1" />
                    <span>{t("blogNavi.prev")}</span>
                </div>
                <span class="blog-navi-title">
                    {prev.data.title}
                </span>
            </a>
            )}
        </div>
        <div class="flex-1 min-w-0">
            {next && (
            <a 
                href={getPostUrl(next.id)} 
                class="blog-navi-link blog-navi-link-next group"
            >
                <div class="blog-navi-label">
                    <span>{t("blogNavi.next")}</span>
                    <Icon name="fa6-solid:arrow-right" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" />
                </div>
                <span class="blog-navi-title">
                    {next.data.title}
                </span>
            </a>
            )}
        </div>
    </div>
</nav>

<style>
  .blog-navi {
    margin-top: 0.85rem;
    padding: 0.55rem;
    border: 1px solid var(--button-border-color);
    border-radius: 6px;
    background: var(--surface-color);
  }

  .blog-navi-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.55rem;
  }

  .blog-navi-link {
    display: flex;
    height: 100%;
    min-height: 5.25rem;
    flex-direction: column;
    gap: 0.45rem;
    justify-content: center;
    padding: 0.85rem 0.95rem;
    border-radius: 5px;
    color: inherit;
    text-decoration: none;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .blog-navi-link:hover {
    background: var(--button-hover-color);
  }

  .blog-navi-link-next {
    align-items: flex-end;
    text-align: right;
  }

  .blog-navi-label {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--text-color-70);
    font-size: 0.82rem;
    line-height: 1.3;
    transition: color 0.2s ease;
  }

  .blog-navi-link:hover .blog-navi-label {
    color: var(--text-color);
  }

  .blog-navi-title {
    display: -webkit-box;
    overflow: hidden;
    color: var(--text-color);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.45;
    transition: color 0.2s ease;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .blog-navi-link:hover .blog-navi-title {
    color: var(--link-color);
  }

  @media (max-width: 640px) {
    .blog-navi-grid {
      grid-template-columns: 1fr;
    }

    .blog-navi-link {
      min-height: 4.5rem;
    }
  }
</style>
