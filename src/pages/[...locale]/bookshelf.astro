---
import MainPageLayout from '@layouts/MainPageLayout.astro';
import Cover from '@components/Cover.astro';
import FabMenu from '@components/control/FabMenu.astro';
import Bookshelf from '@components/bookshelf/Bookshelf.svelte';
import PostCard from '@components/PostCard.astro';
import { Icon } from "astro-icon/components";

import { getBooks, toBookMeta, buildBookReviewMap, getBookReviews } from '@utils/book-utils';
import { contentCoverUrl } from '@utils/url-utils';
import { siteConfig } from '@/config';
import { i18n } from "astro:config/client";

import i18nit from '@i18n/translation'

export async function getStaticPaths() {
    return i18n?.locales.map(locale => ({
        params: { locale: locale == i18n?.defaultLocale ? undefined : (locale as string) }
    }));
}

const currentLang = Astro.currentLocale || i18n!.defaultLocale;
const t = i18nit(currentLang);

const bookEntries = await getBooks(currentLang);
const reviewMap = await buildBookReviewMap(currentLang);
const books = bookEntries.map((entry) => {
    // entry.id = "example-book/zh-cn"，需要去掉 locale 后缀才能匹配 bookSlug
    const parts = entry.id.split("/");
    const slug = parts.length > 1 ? parts.slice(0, -1).join("/") : entry.id;
    return toBookMeta(entry, reviewMap.get(slug));
});

// 书评作为书架的第二个子标签
const reviews = await getBookReviews(currentLang);

const pageTitle = `${t("header.bookshelf")} - ${siteConfig.title}`;
const tabsLabel = `${t("header.bookshelf")} / ${t("header.bookReview")}`;
---

<MainPageLayout title={pageTitle} lang={currentLang}>
    <Cover title={t("cover.title.bookshelf")} subTitle={t("cover.subTitle.bookshelf")} />

    <!-- 首屏绘制前先同步子标签状态，避免带 ?tab= 深链接时闪一下书架 -->
    <script is:inline>
        (function () {
            var tab = new URLSearchParams(window.location.search).get('tab') === 'review' ? 'review' : 'books';
            document.documentElement.dataset.shelfTab = tab;
        })();
    </script>

    <div class="max-w-[var(--page-width)] mx-auto px-4 pb-16">
        <!-- 子标签切换 -->
        <nav id="shelf-tabs" class="shelf-tabs" aria-label={tabsLabel}>
            <a href="?tab=books" class="shelf-tab" data-tab="books" aria-current="true">
                <Icon name="fa6-solid:book-bookmark" class="w-4 h-4" />
                <span>{t("header.bookshelf")}</span>
            </a>
            <a href="?tab=review" class="shelf-tab" data-tab="review" aria-current="false">
                <Icon name="fa6-solid:book-open" class="w-4 h-4" />
                <span>{t("header.bookReview")}</span>
            </a>
        </nav>

        <!-- 书架 -->
        <div id="shelf-panel-books" class="shelf-panel">
            <Bookshelf books={books} client:load />
        </div>

        <!-- 书评 -->
        <div id="shelf-panel-review" class="shelf-panel">
            <p class="text-[var(--text-color-70)] font-bold text-sm mb-2">
                {t("bookReview.reviewCount", { count: reviews.length })}
            </p>
            {reviews.map((entry) => (
                <PostCard
                    entry={entry}
                    title={entry.data.title}
                    description={entry.data.description}
                    image={contentCoverUrl(entry.data.cover || entry.data.image, entry.id, 'book-review')}
                    pubDate={entry.data.pubDate}
                    url={entry.id}
                    fallback={false}
                    urlPrefix="/book-review/"
                    animate={false}
                />
            ))}
        </div>
    </div>

    <FabMenu showBackBottom={true} />

    <script>
        function currentShelfTab() {
            return new URLSearchParams(window.location.search).get('tab') === 'review' ? 'review' : 'books';
        }

        function initShelfTabs() {
            const root = document.getElementById('shelf-tabs');

            // 离开书架页时清理标记，避免影响其它页面
            if (!root) {
                delete document.documentElement.dataset.shelfTab;
                return;
            }

            const apply = (tab) => {
                document.documentElement.dataset.shelfTab = tab;
                root.querySelectorAll('[data-tab]').forEach((el) => {
                    el.setAttribute('aria-current', String(el.dataset.tab === tab));
                });
            };

            apply(currentShelfTab());

            if (root.dataset.bound === 'true') return;
            root.dataset.bound = 'true';

            root.querySelectorAll('[data-tab]').forEach((el) => {
                el.addEventListener('click', (event) => {
                    event.preventDefault();
                    const tab = el.dataset.tab === 'review' ? 'review' : 'books';
                    const url = new URL(window.location.href);
                    if (tab === 'books') {
                        url.searchParams.delete('tab');
                    } else {
                        url.searchParams.set('tab', tab);
                    }
                    window.history.replaceState({}, '', url);
                    apply(tab);
                });
            });
        }

        initShelfTabs();
        document.addEventListener('astro:page-load', initShelfTabs);
    </script>
</MainPageLayout>

<style>
    .shelf-tabs {
        display: flex;
        width: max-content;
        margin: 0 auto 2rem;
        padding: 0.3rem;
        gap: 0.25rem;
        border: 1px solid var(--button-border-color);
        border-radius: 0.9rem;
    }

    .shelf-tab {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.55rem 1.35rem;
        border-radius: 0.65rem;
        font-size: 0.95rem;
        font-weight: 600;
        line-height: 1.4;
        color: var(--text-color-70);
        transition: color 0.25s ease, background-color 0.25s ease, box-shadow 0.25s ease;
        -webkit-tap-highlight-color: transparent;
    }

    .shelf-tab:hover {
        color: var(--link-color);
        background-color: var(--button-hover-color);
    }

    :global(html[data-shelf-tab="books"]) .shelf-tab[data-tab="books"],
    :global(html[data-shelf-tab="review"]) .shelf-tab[data-tab="review"] {
        color: #fff;
        background-color: var(--link-color);
        box-shadow: 0 2px 10px var(--shadow-color);
    }

    /* 面板切换：默认展示书架 */
    #shelf-panel-review {
        display: none;
    }

    :global(html[data-shelf-tab="review"]) #shelf-panel-books {
        display: none;
    }

    :global(html[data-shelf-tab="review"]) #shelf-panel-review {
        display: block;
    }

    @media (max-width: 640px) {
        .shelf-tabs {
            width: 100%;
            border-radius: 0.75rem;
        }

        .shelf-tab {
            flex: 1;
            justify-content: center;
            padding: 0.55rem 0.75rem;
        }
    }
</style>
