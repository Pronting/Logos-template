---
import MainPageLayout from '@layouts/MainPageLayout.astro'
import ArchivePanel from '@components/ArchivePanel.svelte'
import FabMenu from '@components/control/FabMenu.astro'
import { siteConfig } from '@/config'
import { getBlogEntrySort } from '@utils/content-utils'
import { getBookReviews } from '@utils/book-utils'
import { getAllColumnArticles } from '@utils/column-utils'
import i18nit from '@i18n/translation'
import { i18n } from "astro:config/client";



const currentLang = Astro.currentLocale || i18n!.defaultLocale;
const defaultLocale = i18n!.defaultLocale;
const t = i18nit(currentLang);

export async function getStaticPaths() {
	return i18n?.locales.map(locale => ({ params: { locale: locale == i18n?.defaultLocale ? undefined : (locale as string) } }));
}

// 获取所有博客文章并按发布日期降序排序
const allBlogPosts = await getBlogEntrySort(currentLang);

// 获取书评文章，标记 URL 前缀，合并进归档列表
const bookReviews = (await getBookReviews(currentLang)).map(r => ({
    ...r,
    urlPrefix: "/book-review/"
}));

// 获取专栏文章，标记 URL 前缀（含专栏 slug），合并进归档列表
const columnArticles = (await getAllColumnArticles(currentLang)).map(a => ({
    ...a,
    urlPrefix: `/column/${a.columnSlug}/`
}));

const allPosts = [
    ...allBlogPosts.map(p => ({ ...p, urlPrefix: "/blog/" })),
    ...bookReviews,
    ...columnArticles,
].sort((a, b) => {
    // 置顶优先（pinTop 降序），再按发布日期降序
    const pinTopA = a.data.pinTop ?? 0;
    const pinTopB = b.data.pinTop ?? 0;
    if (pinTopA !== pinTopB) return pinTopB - pinTopA;
    return (b.data.pubDate?.valueOf() ?? 0) - (a.data.pubDate?.valueOf() ?? 0);
});

const pageTitle = t("header.archive") + " - " + siteConfig.title;
---

<MainPageLayout title={pageTitle} lang={currentLang}>
    <ArchivePanel
        client:only="svelte"
        sortedPosts={allPosts}
        currentLang={currentLang}
        defaultLocale={i18n!.defaultLocale}
    />
    <FabMenu showBackBottom={true} />
</MainPageLayout>