---
import MainPageLayout from '@layouts/MainPageLayout.astro'
import FabMenu from '@components/control/FabMenu.astro'
import { Icon } from "astro-icon/components"
import { siteConfig } from '@/config'
import { i18n } from "astro:config/client"
import i18nit from '@i18n/translation'
import { getColumns, getColumnArticles } from '@utils/column-utils'
import { getRelativeLocaleUrl } from '@utils/url-utils'
import { formatFullDate } from '@/utils/time'
import type { GetStaticPaths } from 'astro'

export async function getStaticPaths() {
    const defaultLang = i18n.defaultLocale;
    const columns = await getColumns(defaultLang);
    return columns.map(col => ({
        params: { slug: col.id },
        props: { column: col },
    }));
}

const { column } = Astro.props;
const currentLang = Astro.currentLocale || i18n!.defaultLocale;
const t = i18nit(currentLang);
const articles = await getColumnArticles(currentLang, column.id);

// Pre-compute article count text
const articleCountText = t("column.articleCount", { count: articles.length });
const pageTitle = `${column.data.title} - ${t("column.series")} - ${siteConfig.title}`;
---

<MainPageLayout title={pageTitle} lang={currentLang}>
    <div class="mx-auto w-full max-w-[var(--page-width)] py-8 md:mt-0 mt-18">
        <!-- Column Header -->
        <div class="mb-12 text-center" data-aos="fade-up">
            <a
                href={getRelativeLocaleUrl(currentLang, '/')}
                class="inline-flex items-center gap-1.5 text-sm text-[var(--text-color-70)] hover:text-[var(--link-color)] transition-colors mb-6"
            >
                <Icon name="fa6-solid:arrow-left" class="w-3.5 h-3.5" />
                {t("column.backToList")}
            </a>
            <h1 class="font-bold text-3xl text-[var(--text-color)] flex items-center justify-center gap-3">
                {column.data.icon && <Icon name={column.data.icon} class="w-8 h-8 text-[var(--link-color)]" />}
                {column.data.title}
            </h1>
            {column.data.description && (
                <p class="text-[var(--text-color-70)] mt-3 text-lg">{column.data.description}</p>
            )}
            <p class="text-sm text-[var(--text-color-70)] opacity-70 mt-2">
                {articleCountText}
            </p>
        </div>

        <!-- Timeline -->
        {articles.length > 0 ? (
            <div class="timeline-container relative max-w-2xl mx-auto">
                <!-- Timeline line -->
                <div class="timeline-line absolute left-4 md:left-1/2 top-0 bottom-0 w-0.5 bg-[var(--button-border-color)] transform md:-translate-x-1/2"></div>

                {articles.map((article, index) => (
                    <div
                        data-aos="fade-up"
                        data-aos-delay={index * 100}
                        class={`timeline-item relative flex items-start gap-6 mb-10 ${index % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'}`}
                    >
                        <!-- Timeline node -->
                        <div class="timeline-node absolute left-4 md:left-1/2 w-4 h-4 rounded-full bg-[var(--surface-color)] border-2 border-[var(--link-color)] transform -translate-x-1/2 z-10 shadow-sm"></div>

                        <!-- Date side (desktop) -->
                        <div class={`hidden md:block w-1/2 ${index % 2 === 0 ? 'text-right pr-8' : 'text-left pl-8'}`}>
                            <time class="text-sm font-mono text-[var(--text-color-70)]">
                                {formatFullDate(article.data.pubDate, currentLang)}
                            </time>
                            {article.data.tags && article.data.tags.length > 0 && (
                                <div class={`flex flex-wrap gap-1.5 mt-2 ${index % 2 === 0 ? 'justify-end' : 'justify-start'}`}>
                                    {article.data.tags.map((tag) => (
                                        <span class="text-xs px-2 py-0.5 rounded-full bg-[var(--button-hover-color)] text-[var(--text-color-70)]">
                                            {tag}
                                        </span>
                                    ))}
                                </div>
                            )}
                        </div>

                        <!-- Content card -->
                        <div class="ml-10 md:ml-0 md:w-1/2">
                            <a
                                href={getRelativeLocaleUrl(currentLang, `/column/${column.id}/${article.id}`)}
                                class="block p-5 rounded-xl shadow border border-[var(--button-border-color)] bg-[var(--surface-color)] hover:shadow-lg hover:border-[var(--link-color)] transition-all duration-300 group"
                            >
                                <!-- Mobile date -->
                                <time class="md:hidden block text-xs font-mono text-[var(--text-color-70)] mb-2">
                                    {formatFullDate(article.data.pubDate, currentLang)}
                                </time>
                                <h3 class="font-semibold text-lg text-[var(--text-color)] group-hover:text-[var(--link-color)] transition-colors flex items-center gap-2">
                                    {article.data.title}
                                    <Icon
                                        name="fa6-solid:angle-right"
                                        class="w-4 h-4 opacity-0 group-hover:opacity-100 transform -translate-x-1 group-hover:translate-x-0 transition-all duration-300"
                                    />
                                </h3>
                                {article.data.description && (
                                    <p class="text-sm text-[var(--text-color-70)] mt-2 line-clamp-3">
                                        {article.data.description}
                                    </p>
                                )}
                                <!-- Mobile tags -->
                                {article.data.tags && article.data.tags.length > 0 && (
                                    <div class="md:hidden flex flex-wrap gap-1.5 mt-3">
                                        {article.data.tags.map((tag) => (
                                            <span class="text-xs px-2 py-0.5 rounded-full bg-[var(--button-hover-color)] text-[var(--text-color-70)]">
                                                {tag}
                                            </span>
                                        ))}
                                    </div>
                                )}
                            </a>
                        </div>
                    </div>
                ))}
            </div>
        ) : (
            <div class="text-center text-[var(--text-color-70)] py-12" data-aos="fade-up">
                <Icon name="fa6-solid:inbox" class="w-12 h-12 mx-auto mb-4 opacity-50" />
                <p>{t("column.noColumns")}</p>
            </div>
        )}
    </div>
    <FabMenu showBackBottom={true} />
</MainPageLayout>

<style>
    .timeline-node {
        transition: all 0.3s ease;
    }
    .timeline-item:hover .timeline-node {
        background-color: var(--link-color);
        transform: translateX(-50%) scale(1.3);
    }
    .line-clamp-3 {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>
