---
import '@styles/global.css'
import { siteConfig, licenseConfig } from '@/config'
import MainPageLayout from '@layouts/MainPageLayout.astro'
import Markdown from '@components/misc/Markdown.astro'
import ImageModule from '@components/misc/ImageModule.astro'
import FabMenu from '@components/control/FabMenu.astro'
import TOC from '@components/TOC.svelte'
import LicenseCard from '@components/misc/LicenseCard.astro'
import Comments from '@components/comment/Comments.svelte'
import Twikoo from '@components/comment/thirdparty/twikoo.astro'
import AISummary from '@components/AISummary.astro'
import ViewCounter from '@components/ViewCounter.astro'

import { getCollection, render } from 'astro:content'
import { i18n } from "astro:config/client"
import i18nit from '@i18n/translation'
import { Icon } from "astro-icon/components"

import { blogCoverUrl } from '@/utils/url-utils'
import { formatFullDate } from '@/utils/time'
import { getColumnArticles, getColumns } from '@utils/column-utils'
import { getRelativeLocaleUrl } from '@utils/url-utils'
import { createAiSummaryKey, getAiSummary } from '@utils/ai-summary'

export async function getStaticPaths() {
    const defaultLang = i18n.defaultLocale;
    const columns = await getColumns(defaultLang);
    const paths = [];

    for (const col of columns) {
        const articles = await getColumnArticles(defaultLang, col.id);
        for (const article of articles) {
            paths.push({
                params: { slug: col.id, id: article.id },
                props: { article, column: col },
            });
        }
    }

    return paths;
}

const { article, column } = Astro.props;
const currentLang = Astro.currentLocale || i18n!.defaultLocale;
const t = i18nit(currentLang);
const { Content, headings } = await render(article);

const pageTitle = `${article.data.title} - ${column.data.title} - ${siteConfig.title}`;
const image = blogCoverUrl(article.data.cover || article.data.image, article.id);

const { remarkPluginFrontmatter } = await render(article);
const summaryLocale = article.isFallback ? i18n!.defaultLocale : currentLang;
const aiSummary = getAiSummary(createAiSummaryKey("columnArticle", summaryLocale, `${column.id}/${article.id}`));
---

<MainPageLayout title={pageTitle} lang={currentLang} description={article.data.description}>
    <div class="mx-auto w-full max-w-[var(--page-width)] py-8 md:mt-0 mt-18">
        <!-- Back to column timeline -->
        <div class="mb-6" data-aos="fade-up">
            <a
                href={getRelativeLocaleUrl(currentLang, `/column/${column.id}`)}
                class="inline-flex items-center gap-1.5 text-sm text-[var(--text-color-70)] hover:text-[var(--link-color)] transition-colors"
            >
                <Icon name="fa6-solid:arrow-left" class="w-3.5 h-3.5" />
                {column.data.title}
            </a>
        </div>

        <!-- Article header -->
        <div class="mb-18 text-center">
            <h1 data-pagefind-body class="font-bold text-3xl mb-2 pt-10 text-[var(--text-color)]">{article.data.title}</h1>
            <p class="flex flex-wrap items-center justify-center font-bold text-[var(--text-color-70)] mt-6">
                <Icon name="fa6-solid:calendar-days" class="mr-2"></Icon>
                <span>{formatFullDate(article.data.pubDate, currentLang)}</span>
            </p>
            <div class="flex justify-center">
                <div class="flex flex-wrap items-center justify-center text-sm text-[var(--text-color-70)] mt-2 gap-2">
                    <p class="flex items-center whitespace-nowrap mr-2">
                        <Icon name="fa6-solid:pen-nib" class="mr-1"></Icon>
                        <span class="py-1 px-1">{remarkPluginFrontmatter.words || 0} {t("pagecard.words")}</span>
                    </p>
                    <p class="flex items-center whitespace-nowrap mr-2">
                        <Icon name="fa6-solid:clock" class="mr-1"></Icon>
                        <span class="py-1 px-1">{remarkPluginFrontmatter.minutes || 0} {t("pagecard.minutes")}</span>
                    </p>
                    <p class="flex items-center whitespace-nowrap mr-2">
                        <Icon name="fa6-solid:hashtag" class="mr-1"></Icon>
                        {article.data.tags && article.data.tags.length > 0 ? (
                            article.data.tags.map((tag: string, i: number) => (
                                <>
                                    {i > 0 && <span class="mx-0.5">·</span>}
                                    <a href={getRelativeLocaleUrl(currentLang, `/archives/?tag=${encodeURIComponent(tag)}`)} class="tag-pill">{tag}</a>
                                </>
                            ))
                        ) : (
                            <span class="tag-pill">{t("pagecard.uncategorized")}</span>
                        )}
                    </p>
                    <ViewCounter lang={currentLang} />
                </div>
            </div>
            <AISummary summary={aiSummary?.summary} lang={summaryLocale} />
        </div>

        {image && article.data.showCover !== false && (
            <div class="cover overflow-hidden">
                <ImageModule src={image} class="w-full h-full object-cover"/>
            </div>
        )}

        {article.data.draft && (
        <div class="my-8 flex items-start gap-3 rounded-lg border border-[var(--danger-border-color)] bg-[var(--danger-bg-color)] p-4 text-sm text-[var(--danger-text-color)] transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0 opacity-80">
                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                <line x1="12" y1="9" x2="12" y2="13"/>
                <line x1="12" y1="17" x2="12.01" y2="17"/>
            </svg>
            <div>
                <p class="leading-relaxed">
                    <span class="font-semibold">{t("draftNote.warning")}</span>
                    {t("draftNote.description")}
                </p>
            </div>
        </div>
        )}

        {article.isFallback && (
        <div class="my-8 flex items-start gap-3 rounded-lg border border-[var(--warning-border-color)] bg-[var(--warning-bg-color)] p-4 text-sm text-[var(--warning-text-color)] transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0 opacity-80">
            <circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>
            </svg>
            <div>
            <p class="leading-relaxed">
                <span class="font-semibold">{t("langNote.note")}</span>
                {t("langNote.description")}
            </p>
            </div>
        </div>
        )}

        <Markdown class="mb-6 mt-10 markdown-content onload-animation">
            <Content />
        </Markdown>

        {licenseConfig.enable &&
        <LicenseCard title={article.data.title} pubDate={article.data.pubDate}/>
        }

        {
            (siteConfig.comments.enable && siteConfig.comments.platform === "default") &&
            <Comments postSlug={article.id} language={currentLang} postTitle={article.data.title} client:visible/>
        }
        {
            (siteConfig.comments.enable && siteConfig.comments.platform === "twikoo") &&
            <Twikoo postSlug={article.data.title} language={currentLang} envId={siteConfig.comments.backendUrl}/>
        }
    </div>
    {
        siteConfig.toc.enable &&
        <TOC headings={headings} language={currentLang} client:load/>
    }
    <FabMenu headings={headings} showComment={siteConfig.comments.enable} showBackBottom={!siteConfig.comments.enable}/>
</MainPageLayout>

<style is:global>
.tag-pill {
  transition: all 0.3s ease;
  background-color: transparent;
  display: inline-block;
  border-radius: 0.25rem;
  padding: 0.25rem 0.25rem;
}
.tag-pill:hover {
  color: var(--link-color);
  background-color: var(--button-hover-color);
  text-shadow: 0.5px 0 0 currentColor, -0.5px 0 0 currentColor;
}
</style>
